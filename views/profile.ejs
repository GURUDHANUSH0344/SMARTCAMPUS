<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Update Profile – SmartCampus ERP</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    .form-card { 
      background: white; 
      padding: 32px; 
      border-radius: 24px; 
      border: 1px solid var(--border); 
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      max-width: 600px; 
      margin: 40px auto; 
      animation: formIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes formIn {
      from { opacity: 0; transform: translateY(20px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
  </style>
</head>
<body>
<%- include('partials/navbar') %>
<div class="container">
  <div class="form-card">
    <h1 style="margin-bottom:20px; font-size:20px;">Update Your Details</h1>
    <form action="/student/profile" method="POST">
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" class="form-control" value="<%= student.name %>" required />
      </div>
      <div class="form-group">
        <label>Email (read-only)</label>
        <input type="email" class="form-control" value="<%= student.email %>" readonly style="background:#f9fafb;" />
      </div>
      <div class="form-group">
        <label>Phone Number</label>
        <input type="text" name="phone" class="form-control" value="<%= student.phone || '' %>" placeholder="e.g. +91 9876543210" />
      </div>
      <div class="form-group">
        <label>Course</label>
        <select class="form-control" name="course">
          <option value="" disabled <% if(!student.course) { %>selected<% } %>>Select Course</option>
          <optgroup label="Engineering">
            <option value="B.Tech (CSE)" <%= student.course === 'B.Tech (CSE)' ? 'selected' : '' %>>B.Tech (CSE)</option>
            <option value="B.Tech (ECE)" <%= student.course === 'B.Tech (ECE)' ? 'selected' : '' %>>B.Tech (ECE)</option>
            <option value="B.Tech (ME)" <%= student.course === 'B.Tech (ME)' ? 'selected' : '' %>>B.Tech (ME)</option>
            <option value="B.Tech (CE)" <%= student.course === 'B.Tech (CE)' ? 'selected' : '' %>>B.Tech (CE)</option>
            <option value="B.Tech (EEE)" <%= student.course === 'B.Tech (EEE)' ? 'selected' : '' %>>B.Tech (EEE)</option>
            <option value="B.Tech (IT)" <%= student.course === 'B.Tech (IT)' ? 'selected' : '' %>>B.Tech (IT)</option>
            <option value="B.Tech (Chemical)" <%= student.course === 'B.Tech (Chemical)' ? 'selected' : '' %>>B.Tech (Chemical)</option>
          </optgroup>
          <optgroup label="Management">
            <option value="BBA" <%= student.course === 'BBA' ? 'selected' : '' %>>BBA</option>
            <option value="MBA" <%= student.course === 'MBA' ? 'selected' : '' %>>MBA</option>
          </optgroup>
          <optgroup label="Computer Applications">
            <option value="BCA" <%= student.course === 'BCA' ? 'selected' : '' %>>BCA</option>
            <option value="MCA" <%= student.course === 'MCA' ? 'selected' : '' %>>MCA</option>
          </optgroup>
          <optgroup label="Science & Commerce">
            <option value="B.Sc" <%= student.course === 'B.Sc' ? 'selected' : '' %>>B.Sc</option>
            <option value="B.Com" <%= student.course === 'B.Com' ? 'selected' : '' %>>B.Com</option>
          </optgroup>
        </select>
      </div>
      <div class="form-group">
        <label>Year / Semester</label>
        <select class="form-control" name="year">
          <option value="" disabled <% if(!student.year) { %>selected<% } %>>Select Year & Semester</option>
          <optgroup label="1st Year">
            <option value="1st Year (Sem 1)" <%= student.year === '1st Year (Sem 1)' ? 'selected' : '' %>>Sem 1</option>
            <option value="1st Year (Sem 2)" <%= student.year === '1st Year (Sem 2)' ? 'selected' : '' %>>Sem 2</option>
          </optgroup>
          <optgroup label="2nd Year">
            <option value="2nd Year (Sem 3)" <%= student.year === '2nd Year (Sem 3)' ? 'selected' : '' %>>Sem 3</option>
            <option value="2nd Year (Sem 4)" <%= student.year === '2nd Year (Sem 4)' ? 'selected' : '' %>>Sem 4</option>
          </optgroup>
          <optgroup label="3rd Year">
            <option value="3rd Year (Sem 5)" <%= student.year === '3rd Year (Sem 5)' ? 'selected' : '' %>>Sem 5</option>
            <option value="3rd Year (Sem 6)" <%= student.year === '3rd Year (Sem 6)' ? 'selected' : '' %>>Sem 6</option>
          </optgroup>
          <optgroup label="4th Year">
            <option value="4th Year (Sem 7)" <%= student.year === '4th Year (Sem 7)' ? 'selected' : '' %>>Sem 7</option>
            <option value="4th Year (Sem 8)" <%= student.year === '4th Year (Sem 8)' ? 'selected' : '' %>>Sem 8</option>
          </optgroup>
        </select>
      </div>
      <div class="form-group">
        <label>Address</label>
        <textarea name="address" class="form-control" rows="3"><%= student.address || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%; margin-top:10px;">Save Profile Details</button>
    </form>
  </div>
</div>
</body>
</html>
