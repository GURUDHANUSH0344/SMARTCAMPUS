<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard – SmartCampus ERP</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <style>
    .risk-card-high { border-left: 4px solid #ef4444 !important; }
    .risk-card-mod { border-left: 4px solid #f59e0b !important; }
    .risk-badge-high { background: #fee2e2; color: #991b1b; }
    .risk-badge-mod { background: #fef3c7; color: #92400e; }
  </style>
</head>
<body>
<%- include('partials/navbar') %>
<div class="container">
  <% if (locals.message) { %>
    <div style="background:var(--success-glow); border:1px solid var(--success); padding:12px; border-radius:12px; margin-bottom:20px; color:var(--success); font-weight:600;">
      ✅ <%= message %>
    </div>
  <% } %>
  <div class="page-header">
    <div>
      <h1 class="page-title">Welcome, <%= user ? user.name : 'User' %> 👋</h1>
      <p style="color:var(--muted);margin-top:4px;">SmartCampus ERP — Manage your institution efficiently</p>
    </div>
  </div>

  <% if (user && user.role === 'student') { %>
    <div class="student-info-card">
      <div class="info-item">
        <div class="info-label">Student ID</div>
        <div class="info-value"><%= student ? student.student_id : 'Not Assigned' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Current Course</div>
        <div class="info-value"><%= student ? student.course : 'Update Profile' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Year</div>
        <div class="info-value"><%= student ? student.year : 'Update Profile' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Phone</div>
        <div class="info-value"><%= student ? student.phone : 'Update Profile' %></div>
      </div>
    </div>
  <% } %>

  <div class="stat-grid">
    <div class="stat-card blue">
      <div class="stat-label">Total Admissions</div>
      <div class="stat-value" id="stat-admissions"><%= stats.admissions %></div>
    </div>
    <div class="stat-card green">
      <div class="stat-label">Active Students</div>
      <div class="stat-value" id="stat-students"><%= stats.students %></div>
    </div>
    <div class="stat-card orange">
      <div class="stat-label">Pending Fees</div>
      <div class="stat-value" id="stat-fees"><%= stats.fees %></div>
    </div>
    <div class="stat-card red">
      <div class="stat-label">Hostel Occupants</div>
      <div class="stat-value" id="stat-hostel"><%= stats.hostel %></div>
    </div>
  </div>

  <% if (user && user.role === 'student') { %>
  <h2 style="font-size:16px;font-weight:700;margin-top:24px;margin-bottom:14px;">Recent Fee Records</h2>
  <div class="card" style="margin-bottom: 24px;">
    <% if (myFees.length === 0) { %>
      <div style="padding: 24px; text-align: center; color: var(--muted);">No fee records found.</div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Type</th><th>Amount</th><th>Status</th><th>Due</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% myFees.forEach(f => { %>
              <tr>
                <td><strong><%= f.feeType %></strong></td>
                <td>₹<%= f.amount.toLocaleString() %></td>
                <td><span class="badge badge-<%= f.status.toLowerCase() %>"><%= f.status %></span></td>
                <td><%= f.dueDate || '—' %></td>
                <td>
                  <button class="btn btn-sm btn-ghost" 
                          onclick="dbOpenEdit(this.dataset.id, this.dataset.type, this.dataset.amount, this.dataset.paid, this.dataset.due)"
                          data-id="<%= f.id %>"
                          data-type="<%= f.feeType %>"
                          data-amount="<%= f.amount || 0 %>"
                          data-paid="<%= f.status === 'Paid' ? (f.amount || 0) : 0 %>"
                          data-due="<%= f.dueDate || '' %>">
                    Edit
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
  <% } %>
  
  <% if (user && user.role === 'admin' && typeof riskStudents !== 'undefined' && riskStudents.length > 0) { %>
  <div class="page-header" style="margin-top: 32px; margin-bottom: 16px;">
    <div>
      <h2 style="font-size:18px; font-weight:800; color:var(--text-main); display:flex; align-items:center; gap:10px;">
        🧠 AI Predictive Insights <span class="badge" style="background:#ede9fe; color:#7c3aed; font-size:11px;">BETA</span>
      </h2>
      <p style="color:var(--muted); font-size:13px; margin-top:4px;">Students identified as "At-Risk" based on academic and financial patterns.</p>
    </div>
  </div>

  <div class="dashboard-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-bottom: 32px;">
    <% riskStudents.slice(0, 4).forEach(rs => { %>
      <div class="stat-card risk-card-<%= rs.status === 'High Risk' ? 'high' : 'mod' %>" style="background: white; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0;">
        <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:12px;">
          <div>
            <div style="font-size:15px; font-weight:700; color:var(--text-main);"><%= rs.name %></div>
            <div style="font-size:12px; color:var(--text-muted);">ID: <%= rs.student_id %></div>
          </div>
          <span class="badge risk-badge-<%= rs.status === 'High Risk' ? 'high' : 'mod' %>" style="font-size: 10px;">
            <%= rs.status %>
          </span>
        </div>
        <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">
          <strong>Risk Score:</strong> <%= rs.score.toFixed(1) %>%
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:4px;">
          <% rs.flags.forEach(flag => { %>
            <span style="font-size:10px; padding:2px 8px; border-radius:4px; background:#f1f5f9; color:#475569; border:1px solid #e2e8f0;"><%= flag %></span>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>

  <% if (user && user.role === 'admin' && typeof pendingAdmins !== 'undefined' && pendingAdmins.length > 0) { %>
  <div class="page-header" style="margin-top: 32px; margin-bottom: 16px;">
    <div>
      <h2 style="font-size:18px; font-weight:800; color:var(--text-main); display:flex; align-items:center; gap:10px;">
        🔐 Pending Admin Approvals
        <span style="background:#fee2e2; color:#991b1b; font-size:11px; padding:2px 8px; border-radius:99px; font-weight:700;"><%= pendingAdmins.length %></span>
      </h2>
      <p style="color:var(--muted); font-size:13px; margin-top:4px;">New admin accounts awaiting your approval before they can log in.</p>
    </div>
  </div>
  <div class="card" style="margin-bottom: 28px; border: 1.5px solid #fee2e2; border-radius: 16px; overflow: hidden;">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pendingAdmins.forEach(admin => { %>
          <tr>
            <td><strong><%= admin.name %></strong></td>
            <td style="color:var(--muted);"><%= admin.email %></td>
            <td><span style="background:#fef3c7; color:#92400e; padding:2px 10px; border-radius:99px; font-size:11px; font-weight:600;">⏳ Pending</span></td>
            <td style="display:flex; gap:8px;">
              <form method="POST" action="/auth/approve/<%= admin.id %>" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-primary" style="padding:4px 14px; font-size:12px;">✅ Approve</button>
              </form>
              <form method="POST" action="/auth/reject/<%= admin.id %>" style="display:inline;" onsubmit="return confirm('Reject and remove this admin request?')">
                <button type="submit" class="btn btn-sm" style="padding:4px 14px; font-size:12px; background:#fee2e2; color:#991b1b; border:none; border-radius:8px; cursor:pointer;">❌ Reject</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <h2 style="font-size:16px;font-weight:700;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;">
    Quick Access
    <% if (user && user.role === 'student') { %>
      <div style="display:flex;gap:8px;">
        <a href="/student/export?type=download" class="btn btn-sm btn-outline" style="font-size:11px;">⬇️ Download (Excel)</a>

      </div>
    <% } %>
  </h2>
  <div class="quick-links">
    <a href="/admissions" class="quick-card">
      <div class="quick-icon" style="background:#ede9fe;">📋</div>
      <div><h3>Admissions</h3><p>Manage applications & approvals</p></div>
      <span class="quick-plus">+</span>
    </a>
    <a href="/exams" class="quick-card">
      <div class="quick-icon" style="background:#dbeafe;">📝</div>
      <div><h3>Exam Results</h3><p>Enter and view grades</p></div>
      <span class="quick-plus">+</span>
    </a>
    <a href="/fees" class="quick-card">
      <div class="quick-icon" style="background:#dcfce7;">💰</div>
      <div><h3>Fee Management</h3><p>Track payments & receipts</p></div>
      <span class="quick-plus">+</span>
    </a>
    <a href="/hostel" class="quick-card">
      <div class="quick-icon" style="background:#fef9c3;">🏠</div>
      <div><h3>Hostel</h3><p>Room allocation & occupancy</p></div>
      <span class="quick-plus">+</span>
    </a>
  </div>
</div>

<!-- Edit Modal Overlay for Dashboard -->
<div class="modal-overlay" id="dbEditModal">
  <div class="modal" style="max-width: 450px; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
    <div class="modal-header" style="padding: 20px; border-bottom: 1px solid var(--border);">
      <h2 class="modal-title">Edit Fee</h2>
      <button class="modal-close" onclick="document.getElementById('dbEditModal').classList.remove('open')">&times;</button>
    </div>
    <form id="dbEditForm" method="POST" action="" style="padding: 20px;">
      <div class="form-group" style="margin-bottom: 15px;">
        <label>Type</label>
        <input type="text" name="feeType" id="db-feeType" class="form-control" required />
      </div>
      <div class="form-group" style="margin-bottom: 15px;">
        <label>Total Amount (₹)</label>
        <input type="number" name="amount" id="db-amount" class="form-control" required />
      </div>
      <div class="form-group" style="margin-bottom: 15px;">
        <label>Amount Paid (₹)</label>
        <input type="number" name="amountPaid" id="db-amountPaid" class="form-control" />
      </div>
      <div class="form-group" style="margin-bottom: 20px;">
        <label>Due Date</label>
        <input type="date" name="dueDate" id="db-dueDate" class="form-control" />
      </div>
      <div class="modal-footer" style="padding: 0; margin-top: 10px; border:none; display:flex; gap:10px;">
        <button type="button" class="btn btn-ghost" style="flex:1" onclick="document.getElementById('dbEditModal').classList.remove('open')">Cancel</button>
        <button type="submit" class="btn btn-primary" style="flex:2">Save Fee Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  function dbOpenEdit(id, type, amount, paid, due) {
    const form = document.getElementById('dbEditForm');
    form.action = '/fees/edit/' + id;
    document.getElementById('db-feeType').value = type;
    document.getElementById('db-amount').value = amount;
    document.getElementById('db-amountPaid').value = paid;
    if (due && due !== '—') document.getElementById('db-dueDate').value = due;
    document.getElementById('dbEditModal').classList.add('open');
  }
</script>

<script src="/js/main.js"></script>
</body>
</html>

